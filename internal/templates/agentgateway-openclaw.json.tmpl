{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "{{.GatewayToken}}"
    },
    "remote": {
      "token": "{{.GatewayToken}}"
    },{{if .ChatCompletions}}
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true }
      }
    },{{end}}
    "controlUi": {
      "allowedOrigins": [{{range $i, $o := .AllowedOrigins}}{{if $i}},{{end}}"{{$o}}"{{end}}]
    },
    "trustedProxies": ["10.128.0.0/14", "10.131.0.0/16", "127.0.0.1", "::1"]
  },
  "models": {
    "providers": {
      "openai": {
        "agentRuntime": {"id": "openclaw"},
        "api": "openai-chatgpt-responses",
        "baseUrl": "https://chatgpt.com/backend-api",
        "models": [
          {"api": "openai-chatgpt-responses", "id": "gpt-6.2-sol", "name": "GPT-6.2 Sol"},
          {"api": "openai-chatgpt-responses", "id": "gpt-5.6-sol", "name": "GPT-5.6 Sol"}
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-6.2-sol"
      }
    }
  },
  "bindings": []{{if .HooksJSON}},
  "hooks": {{.HooksJSON}}{{end}}
}
