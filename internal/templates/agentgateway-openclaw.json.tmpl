{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "{{.GatewayToken}}"
    },
    "remote": {
      "token": "{{.GatewayToken}}"
    },
    "controlUi": {
      "allowedOrigins": [{{range $i, $o := .AllowedOrigins}}{{if $i}},{{end}}"{{$o}}"{{end}}]
    },
    "trustedProxies": ["10.128.0.0/14", "10.131.0.0/16", "127.0.0.1", "::1"]
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://chatgpt.com/backend-api",
        "api": "openai-chatgpt-responses",
        "models": [
          {"id": "gpt-5.6-sol", "name": "GPT-5.6 Sol", "api": "openai-chatgpt-responses"},
          {"id": "gpt-5.6", "name": "GPT-5.6", "api": "openai-chatgpt-responses"},
          {"id": "gpt-5.5", "name": "GPT-5.5", "api": "openai-chatgpt-responses"},
          {"id": "gpt-5.4", "name": "GPT-5.4", "api": "openai-chatgpt-responses"}
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-sol"
      }
    },
    "list": []
  },
  "bindings": []
}
